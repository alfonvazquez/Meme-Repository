@model List<Meme>
@inject ImageStorage ImageStorage
@{
    ViewData["Title"] = "Memes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Memes</h1>
    <a class="btn btn-success" asp-action="Create">Add Meme</a>
</div>

<form id="filters" method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
    <div class="col-md-4">
        <label class="form-label" for="search">Name</label>
        <input class="form-control" id="search" name="search" value="@ViewBag.Search"
               placeholder="Search by Name or KeyWords" />
    </div>

    <div class="col-md-3">
        <label class="form-label" for="gen">Gen</label>
        <select class="form-select" id="gen" name="gen">
            <option value="">All</option>
            @foreach (var type in Enum.GetValues<Gen>())
            {
                <option value="@type" selected="@(type == ViewBag.Gen)">@Html.DisplayFor(m => type)</option>
            }
        </select>
    </div>

    <div class="col-md-2">
        <label class="form-label" for="size">Per page</label>
        <select class="form-select" id="size" name="size">
            @foreach (var option in (int[])ViewBag.PageSizes)
            {
                <option value="@option" selected="@(option == (int)ViewBag.Size)">@option</option>
            }
        </select>
    </div>

    <div class="col-md-3">
        <button class="btn btn-primary" type="submit">Filter</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Clean</a>
    </div>
</form>

<div id="results">
    <partial name="_MemesList" model="Model" />
</div>

@section Scripts {
    <script>
        const form = document.getElementById("filters");
        const results = document.getElementById("results");
        let timer;
        let controller;

        async function refresh() {
            const params = new URLSearchParams(new FormData(form));
            for (const [key, value] of [...params]) {
                if (value === "") {
                    params.delete(key);
                }
            }

            const query = params.toString();
            const url = query ? `${form.action}?${query}` : form.action;

            controller?.abort();
            controller = new AbortController();

            try {
                const response = await fetch(url, {
                    headers: { "X-Requested-With": "XMLHttpRequest" },
                    signal: controller.signal
                });
                if (!response.ok) {
                    return;
                }

                results.innerHTML = await response.text();
                history.replaceState(null, "", url);
            } catch (error) {
                if (error.name !== "AbortError") {
                    console.error(error);
                }
            }
        }

        form.elements.search.addEventListener("input", () => {
            clearTimeout(timer);
            timer = setTimeout(refresh, 300);
        });

        form.elements.gen.addEventListener("change", refresh);
        form.elements.size.addEventListener("change", refresh);
    </script>
}