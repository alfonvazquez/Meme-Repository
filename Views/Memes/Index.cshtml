@model List<Meme>
@{
    ViewData["Title"] = "Memes";
}

<h1>Memes</h1>
<p>There are @Model.Count memes.</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            @* <th>Image</th>
            <th>Score</th> *@
        </tr>
    </thead>
    <tbody>
        @foreach (var meme in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@meme.Id">@meme.Name</a></td>
                <td>@meme.Description</td>
                @* <td>@meme.Image</td>
                <td>@meme.Score</td> *@
            </tr>
        }
    </tbody>
</table>
