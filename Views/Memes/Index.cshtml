@model List<Meme>
@inject ImageStorage ImageStorage
@{
    ViewData["Title"] = "Memes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Memes</h1>
    <a class="btn btn-success" asp-action="Create">Add Meme</a>
</div>

<form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
    <div class="col-md-4">
        <label class="form-label" for="search">Name</label>
        <input class="form-control" id="search" name="search" value="@ViewBag.Search" placeholder="Buscar por nombre" />
    </div>

    <div class="col-md-3">
        <label class="form-label" for="gen">Gen</label>
        <select class="form-select" id="gen" name="gen">
            <option value="">All</option>
            @foreach (var type in Enum.GetValues<Gen>())
            {
                <option value="@type" selected="@(type == ViewBag.Gen)">@Html.DisplayFor(m => type)</option>
            }
        </select>
    </div>

    <div class="col-md-3">
        <button class="btn btn-primary" type="submit">Filter</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Clean</a>
    </div>
</form>

<p>There are @Model.Count memes.</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th></th>
            <th>Name</th>
            <th>Description</th>
            <th>Gen</th>
            @* <th>Image</th>
            <th>Score</th> *@
        </tr>
    </thead>
    <tbody>
        @foreach (var meme in Model)
        {
            
            <tr>
                @{
                    var imageUrl = ImageStorage.GetUrl(meme.ImageFileName, ImageFolder.MemesImg);
                }
                <td>
                    @if (imageUrl is not null)
                    {
                        <img src="@imageUrl" alt="@meme.Name" loading="lazy"
                             style="width: 64px; height: 64px; object-fit: cover;" />
                    }
                </td>
                <td><a asp-action="Details" asp-route-id="@meme.Id">@meme.Name</a></td>
                <td>@meme.Description</td>
                <td>@meme.Gen</td>
                @*<td>@meme.Score</td> *@
            </tr>
        }
    </tbody>
</table>
